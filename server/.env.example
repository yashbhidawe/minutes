# Minutes backend configuration.
# Copy this file to .env and fill in your values. Never commit the real .env file.

# --- Authentication ---
# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# --- AI services ---
# Groq (Whisper transcription): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Google Gemini (summarization + embeddings): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Cloudflare R2 (audio storage) ---
# https://dash.cloudflare.com -> R2 -> Manage API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=minutes

# --- Database ---
# Postgres URL using the postgresql+psycopg:// scheme (Neon, Supabase, or local Postgres).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/minutes

# --- Celery broker ---
REDIS_URL=redis://localhost:6379/0
